@page "/admin/discover"
@layout Layout.AdminLayout
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@attribute [Authorize]
@inject HttpClient Http

<div class="space-y-6 opacity-0 animate-backdrop-in">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-text-main">Discover Manga</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">Browse and scrape manga from external providers</p>
        </div>
    </div>

    <!-- Search & Filter Panel -->
    <div class="bg-surface p-5 rounded-2xl border border-border-main shadow-sm space-y-4 transition-colors duration-300">

        <!-- Row 1: Provider + Keyword -->
        <div class="flex flex-col md:flex-row gap-4">

            <!-- Provider ComboBox -->
            <div class="w-full md:w-64 space-y-1">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Provider</label>
                <select @bind="selectedProvider" class="w-full px-3 py-2.5 bg-bg-app border border-border-main rounded-xl text-sm outline-none focus:border-primary transition-all text-text-main">
                    <option value="">-- Select Provider --</option>
                    @foreach (var p in providers)
                    {
                        <option value="@p.ProviderName">@p.ProviderName &nbsp;(@p.BaseUrl)</option>
                    }
                </select>
            </div>

            <!-- Keyword Search -->
            <div class="relative flex-grow">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Keyword</label>
                <div class="relative mt-1">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </span>
                    <input type="text" @bind="keyword" @bind:event="oninput" @onkeyup="HandleSearchKeyup"
                           placeholder="Search manga title..."
                           class="w-full pl-11 pr-4 py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-sm text-text-main" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-end gap-2">
                <button @onclick="ToggleAdvancedFilters" 
                        class="px-4 py-2.5 bg-surface border border-border-main rounded-xl text-sm font-semibold text-text-main hover:bg-bg-app transition-all shadow-sm flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    Filters
                </button>
                <button @onclick="ApplySearch" disabled="@(string.IsNullOrEmpty(selectedProvider))"
                        class="px-6 py-2.5 bg-primary text-white font-bold text-xs uppercase tracking-widest rounded-xl hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 disabled:opacity-40 disabled:cursor-not-allowed">
                    Search
                </button>
            </div>
        </div>

        @if (showAdvancedFilters)
        {
            <!-- Row 2: Advanced Filters -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-border-main/50 animate-in slide-in-from-top-4 duration-300">

                <div class="flex-1 space-y-1">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Status</label>
                    <select @bind="filterStatus" class="w-full px-3 py-2 bg-bg-app border border-border-main rounded-lg text-sm outline-none focus:border-primary transition-all text-text-main">
                        <option value="">All Status</option>
                        <option value="ongoing">Ongoing</option>
                        <option value="completed">Completed</option>
                        <option value="hiatus">Hiatus</option>
                    </select>
                </div>

                <div class="flex-1 space-y-1">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Type</label>
                    <select @bind="filterType" class="w-full px-3 py-2 bg-bg-app border border-border-main rounded-lg text-sm outline-none focus:border-primary transition-all text-text-main">
                        <option value="">All Types</option>
                        <option value="manga">Manga</option>
                        <option value="manhwa">Manhwa</option>
                        <option value="manhua">Manhua</option>
                    </select>
                </div>

                <div class="flex items-end">
                    <button @onclick="ResetFilters" class="px-4 py-2 text-slate-500 dark:text-slate-400 text-xs font-bold uppercase hover:bg-bg-app rounded-lg transition-all border border-border-main">
                        Reset
                    </button>
                </div>
            </div>

            <!-- Row 3: Genre Multiple Choice -->
            <div class="space-y-1.5 pt-4 border-t border-border-main/50 animate-in slide-in-from-top-4 duration-300">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Genres</label>
                <div class="flex flex-wrap gap-2 p-3 bg-bg-app rounded-xl border border-border-main max-h-36 overflow-y-auto">
                    @foreach (var genre in availableGenres)
                    {
                        var g = genre;
                        <button @onclick="() => ToggleGenre(g)" 
                                class="px-3 py-1 rounded-lg text-xs font-semibold transition-all @(selectedGenres.Contains(g) ? "bg-primary text-white shadow-md shadow-primary/20" : "bg-surface text-slate-500 border border-border-main hover:border-slate-300 dark:hover:border-slate-600")">
                            @g
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Results Info -->
    @if (hasSearched)
    {
        <div class="flex items-center justify-between">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                @if (isLoading)
                {
                    <span>Searching...</span>
                }
                else
                {
                    <span>Found <span class="font-bold text-text-main">@results.Count</span> results on page <span class="font-bold text-text-main">@currentPage</span></span>
                }
            </p>
            <p class="text-xs text-slate-400">Provider: <span class="font-semibold text-text-main">@selectedProvider</span></p>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-24">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mb-4"></div>
            <p class="text-slate-500 font-medium">Fetching manga from @selectedProvider...</p>
        </div>
    }
    else if (hasSearched && !results.Any())
    {
        <div class="bg-surface rounded-2xl border border-border-main p-12 text-center space-y-4 transition-colors duration-300">
            <div class="w-20 h-20 bg-bg-app rounded-full flex items-center justify-center mx-auto">
                <svg class="w-10 h-10 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="max-w-xs mx-auto">
                <h3 class="text-lg font-bold text-text-main">No results found</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">Try a different keyword or provider.</p>
            </div>
        </div>
    }
    else if (hasSearched && results.Any())
    {
        <!-- Manga Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
            @foreach (var item in results)
            {
                var cardItem = new DiscoverCard.SearchItem
                {
                    Title = item.Title,
                    DetailUrl = item.DetailUrl,
                    Thumbnail = item.Thumbnail,
                    Type = item.Type,
                    Genre = item.Genre,
                    LastUpdateText = item.LastUpdateText,
                    LatestChapterNumber = item.LatestChapterNumber,
                    LatestScrapped = item.LatestScrapped,
                    CurrentChapterNumber = item.CurrentChapterNumber,
                    MangaId = item.MangaId
                };
                <DiscoverCard Item="cardItem" OnCardClick="() => OpenScrapModal(item)" />
            }
        </div>

        <!-- Pagination -->
        <div class="flex flex-col items-center gap-4 pt-6">

            <!-- Page buttons -->
            <div class="flex items-center gap-1.5 flex-wrap justify-center">
                <!-- Prev -->
                <button @onclick="PrevPage" disabled="@(currentPage <= 1)"
                        class="p-2 rounded-xl border border-border-main text-slate-600 dark:text-slate-400 hover:bg-bg-app disabled:opacity-30 disabled:cursor-not-allowed transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <!-- Dynamic Page Range (Current Page centered, max 5 pages) -->
                @{
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = startPage + 4;
                    for (int pg = startPage; pg <= endPage; pg++)
                    {
                        var pageNum = pg;
                        <button @onclick="() => GoToPage(pageNum)"
                                class="w-9 h-9 rounded-xl font-bold text-sm transition-all @(currentPage == pageNum ? "bg-primary text-white shadow-lg shadow-primary/20" : "bg-surface border border-border-main text-slate-600 dark:text-slate-400 hover:border-primary hover:text-primary")">
                            @pageNum
                        </button>
                    }
                }

                <!-- Ellipsis / Next -->
                <span class="px-1 text-slate-300 dark:text-slate-600 font-bold">···</span>

                <!-- Next -->
                <button @onclick="NextPage"
                        class="p-2 rounded-xl border border-border-main text-slate-600 dark:text-slate-400 hover:bg-bg-app transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Manual Page Jump -->
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-400 whitespace-nowrap">Go to page:</label>
                <input type="number" @bind="manualPageInput" min="1"
                       class="w-16 px-2 py-1.5 bg-bg-app border border-border-main rounded-lg text-sm text-center text-text-main outline-none focus:border-primary transition-all" />
                <button @onclick="GoToManualPage"
                        class="px-3 py-1.5 bg-surface border border-border-main rounded-lg text-xs font-semibold text-text-main hover:border-primary hover:text-primary transition-all">
                    Go
                </button>
            </div>
        </div>
    }
    else if (!hasSearched)
    {
        <!-- Initial empty state -->
        <div class="bg-surface rounded-2xl border border-border-main p-16 text-center space-y-4 transition-colors duration-300">
            <div class="w-24 h-24 bg-gradient-to-br from-primary/20 to-secondary/10 rounded-full flex items-center justify-center mx-auto">
                <svg class="w-12 h-12 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <div class="max-w-sm mx-auto">
                <h3 class="text-lg font-bold text-text-main">Start Discovering</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Select a provider and enter a keyword to search for manga to scrape.</p>
            </div>
        </div>
    }

</div>

<!-- ===== Scrap Action Modal ===== -->
@if (selectedItem != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @onclick="CloseModal">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm animate-in fade-in duration-200"></div>

        <!-- Modal Card -->
        <div class="relative z-10 w-full max-w-md bg-surface rounded-2xl border border-border-main shadow-2xl overflow-hidden animate-in zoom-in-95 fade-in duration-200"
             @onclick:stopPropagation="true">

            <!-- Thumbnail Header -->
            <div class="relative h-36 bg-bg-app overflow-hidden">
                @if (!string.IsNullOrEmpty(selectedItem.Thumbnail))
                {
                    <img src="@ProxyThumbnail(selectedItem.Thumbnail)" alt="@selectedItem.Title"
                         class="w-full h-full object-cover" />
                }
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>

                <!-- Close Button -->
                <button @onclick="CloseModal"
                        class="absolute top-3 right-3 w-8 h-8 bg-black/40 hover:bg-black/60 backdrop-blur-sm rounded-full flex items-center justify-center text-white transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="px-6 pb-6 -mt-6 relative">
                <!-- Title & Meta -->
                <div class="mb-5">
                    <h2 class="text-lg font-bold text-text-main leading-snug line-clamp-2">@selectedItem.Title</h2>
                    <div class="flex flex-wrap gap-2 mt-2">
                        @if (!string.IsNullOrEmpty(selectedItem.Type))
                        {
                            <span class="px-2 py-0.5 bg-primary/10 text-primary text-[11px] font-bold rounded-md uppercase">@selectedItem.Type</span>
                        }
                        @if (selectedItem.LatestChapterNumber > 0)
                        {
                            <span class="px-2 py-0.5 bg-secondary/10 text-secondary text-[11px] font-bold rounded-md">Ch. @selectedItem.LatestChapterNumber</span>
                        }
                        @if (!string.IsNullOrEmpty(selectedItem.Genre))
                        {
                            <span class="px-2 py-0.5 bg-bg-app border border-border-main text-slate-400 text-[11px] rounded-md line-clamp-1 max-w-[12rem]">@selectedItem.Genre</span>
                        }
                    </div>
                    <p class="text-xs text-slate-400 mt-2 break-all">@selectedItem.DetailUrl</p>
                </div>

                <!-- Divider -->
                <div class="border-t border-border-main mb-5"></div>

                <!-- Action Buttons -->
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Scrape Action</p>

                <div class="space-y-3">
                    <!-- Scrap Metadata -->
                    <button @onclick="ScrapMetadata" disabled="@isScrapLoading"
                            class="w-full flex items-center gap-4 p-4 bg-bg-app hover:bg-primary/5 border border-border-main hover:border-primary/40 rounded-xl transition-all group disabled:opacity-50 disabled:cursor-not-allowed">
                        <div class="w-10 h-10 bg-primary/10 group-hover:bg-primary/20 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors">
                            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <div class="text-left">
                            <p class="text-sm font-bold text-text-main group-hover:text-primary transition-colors">Scrap Metadata Only</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Fetch title, genre, cover, and description</p>
                        </div>
                    </button>

                    <!-- Scrap All Chapters -->
                    <button @onclick="ScrapAllChapters" disabled="@isScrapLoading"
                            class="w-full flex items-center gap-4 p-4 bg-bg-app hover:bg-secondary/5 border border-border-main hover:border-secondary/40 rounded-xl transition-all group disabled:opacity-50 disabled:cursor-not-allowed">
                        <div class="w-10 h-10 bg-secondary/10 group-hover:bg-secondary/20 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors">
                            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                        </div>
                        <div class="text-left">
                            <p class="text-sm font-bold text-text-main group-hover:text-secondary transition-colors">Scrap All Chapters</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Download and index all available chapters</p>
                        </div>
                    </button>
                </div>

                <!-- Scrap Loading / Result -->
                @if (isScrapLoading)
                {
                    <div class="mt-4 flex items-center gap-3 p-3 bg-primary/5 border border-primary/20 rounded-xl">
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary flex-shrink-0"></div>
                        <p class="text-xs font-medium text-primary">Processing request...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(scrapResultMessage))
                {
                    <div class="mt-4 p-3 @(scrapResultIsError ? "bg-red-500/10 border-red-500/30 text-red-400" : "bg-green-500/10 border-green-500/30 text-green-400") border rounded-xl">
                        <p class="text-xs font-medium">@scrapResultMessage</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // ── Local DTOs (mirror of server-side models) ───────────────────────────
    private class ProviderInfo
    {
        [JsonPropertyName("providerName")]
        public string ProviderName { get; set; } = string.Empty;
        [JsonPropertyName("baseUrl")]
        public string BaseUrl { get; set; } = string.Empty;
    }

    private class SearchItem
    {
        [JsonPropertyName("title")]
        public string? Title { get; set; }
        [JsonPropertyName("detailUrl")]
        public string DetailUrl { get; set; } = string.Empty;
        [JsonPropertyName("thumbnail")]
        public string Thumbnail { get; set; } = string.Empty;
        [JsonPropertyName("type")]
        public string Type { get; set; } = string.Empty;
        [JsonPropertyName("genre")]
        public string Genre { get; set; } = string.Empty;
        [JsonPropertyName("lastUpdateText")]
        public string LastUpdateText { get; set; } = string.Empty;
        [JsonPropertyName("latestChapterNumber")]
        public double LatestChapterNumber { get; set; }
        [JsonPropertyName("latestScrapped")]
        public DateTime? LatestScrapped { get; set; }
        [JsonPropertyName("currentChapterNumber")]
        public double CurrentChapterNumber { get; set; }
        [JsonPropertyName("mangaId")]
        public Guid? MangaId { get; set; }
    }

    private class ScrapRequest
    {
        [JsonPropertyName("mangaUrl")]
        public string MangaUrl { get; set; } = string.Empty;
        [JsonPropertyName("scrapChapters")]
        public bool ScrapChapters { get; set; }
    }

    // ── State ────────────────────────────────────────────────────────────────
    private List<ProviderInfo> providers = new();

    // Filter
    private string selectedProvider = "";
    private string keyword = "";
    private string filterStatus = "";
    private string filterType = "";
    private List<string> selectedGenres = new();
    private List<string> availableGenres = new();
    private bool showAdvancedFilters = false;

    // Results
    private List<SearchItem> results = new();
    private bool isLoading = false;
    private bool hasSearched = false;

    // Pagination
    private int currentPage = 1;
    private int manualPageInput = 1;

    // Modal
    private SearchItem? selectedItem = null;
    private bool isScrapLoading = false;
    private string scrapResultMessage = "";
    private bool scrapResultIsError = false;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadProviders(), LoadGenres());
    }

    private async Task LoadGenres()
    {
        try
        {
            availableGenres = await Http.GetFromJsonAsync<List<string>>("/api/manga/genres") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading genres: {ex.Message}");
        }
    }

    private async Task LoadProviders()
    {
        try
        {
            providers = await Http.GetFromJsonAsync<List<ProviderInfo>>("/api/scrapper/providers") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading providers: {ex.Message}");
        }
    }

    // ── Search ───────────────────────────────────────────────────────────────
    private async Task ApplySearch()
    {
        if (string.IsNullOrEmpty(selectedProvider)) return;
        currentPage = 1;
        manualPageInput = 1;
        await FetchResults();
    }

    private async Task ResetFilters()
    {
        keyword = "";
        filterStatus = "";
        filterType = "";
        selectedGenres.Clear();
        currentPage = 1;
        manualPageInput = 1;
        results.Clear();
        hasSearched = false;
    }

    private async Task HandleSearchKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearch();
    }

    private async Task FetchResults()
    {
        if (string.IsNullOrEmpty(selectedProvider)) return;

        isLoading = true;
        hasSearched = true;
        results.Clear();
        StateHasChanged();

        try
        {
            var url = $"/api/scrapper/{Uri.EscapeDataString(selectedProvider)}/manga/search?page={currentPage}";

            if (!string.IsNullOrWhiteSpace(keyword))
                url += $"&keyword={Uri.EscapeDataString(keyword)}";

            if (!string.IsNullOrWhiteSpace(filterStatus))
                url += $"&status={Uri.EscapeDataString(filterStatus)}";

            if (!string.IsNullOrWhiteSpace(filterType))
                url += $"&type={Uri.EscapeDataString(filterType)}";

            if (selectedGenres.Any())
            {
                foreach (var genre in selectedGenres)
                {
                    url += $"&genres={Uri.EscapeDataString(genre)}";
                }
            }

            results = await Http.GetFromJsonAsync<List<SearchItem>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching results: {ex.Message}");
            results = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleGenre(string genre)
    {
        if (selectedGenres.Contains(genre))
            selectedGenres.Remove(genre);
        else
            selectedGenres.Add(genre);
    }

    private void ToggleAdvancedFilters() => showAdvancedFilters = !showAdvancedFilters;

    // ── Pagination ───────────────────────────────────────────────────────────
    private async Task GoToPage(int page)
    {
        if (page < 1) return;
        currentPage = page;
        manualPageInput = page;
        await FetchResults();
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
            await GoToPage(currentPage - 1);
    }

    private async Task NextPage() => await GoToPage(currentPage + 1);

    private async Task GoToManualPage()
    {
        if (manualPageInput >= 1)
            await GoToPage(manualPageInput);
    }

    // ── Modal ────────────────────────────────────────────────────────────────
    private void OpenScrapModal(SearchItem item)
    {
        selectedItem = item;
        scrapResultMessage = "";
        scrapResultIsError = false;
        isScrapLoading = false;
    }

    private void CloseModal()
    {
        if (isScrapLoading) return;
        selectedItem = null;
        scrapResultMessage = "";
    }

    private async Task ScrapMetadata()
    {
        if (selectedItem == null || string.IsNullOrEmpty(selectedProvider)) return;
        await PostScrap(scrapChapters: false);
    }

    private async Task ScrapAllChapters()
    {
        if (selectedItem == null || string.IsNullOrEmpty(selectedProvider)) return;
        await PostScrap(scrapChapters: true);
    }

    /// <summary>
    /// Routes external thumbnail URLs through the server-side image proxy to avoid
    /// ERR_BLOCKED_BY_ORB / CORS issues with providers that don't set CORS headers.
    /// </summary>
    private static string ProxyThumbnail(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        // Already a relative/local path — no proxying needed
        if (!url.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return url;
        return $"/api/images/proxy?url={Uri.EscapeDataString(url)}";
    }

    private async Task PostScrap(bool scrapChapters)
    {
        if (selectedItem == null) return;

        isScrapLoading = true;
        scrapResultMessage = "";
        scrapResultIsError = false;

        try
        {
            var request = new ScrapRequest
            {
                MangaUrl = selectedItem.DetailUrl,
                ScrapChapters = scrapChapters
            };

            var response = await Http.PostAsJsonAsync(
                $"/api/scrapper/{Uri.EscapeDataString(selectedProvider)}/manga",
                request
            );

            if (response.IsSuccessStatusCode)
            {
                scrapResultMessage = scrapChapters
                    ? "✓ All chapters queued for scraping!"
                    : "✓ Metadata scraping started!";
                scrapResultIsError = false;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                scrapResultMessage = $"Error {(int)response.StatusCode}: {error}";
                scrapResultIsError = true;
            }
        }
        catch (Exception ex)
        {
            scrapResultMessage = $"Request failed: {ex.Message}";
            scrapResultIsError = true;
        }
        finally
        {
            isScrapLoading = false;
        }
    }
}