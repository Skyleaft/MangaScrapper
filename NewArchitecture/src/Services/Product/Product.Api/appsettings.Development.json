{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Authentication": {
    "Authority": "http://localhost:5010",
    "Audience": "product-api",
    "RequireHttps": false,
    "CacheMinutes": 60
  },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=novastack_products_dev;Username=myuser;Password=mypassword;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true

    // ── Switch to MongoDB ─────────────────────────────────────────────────
    // To use MongoDB instead, replace the block above with the following:
    //
    // "Provider": "MongoDB",
    // "ConnectionString": "mongodb://myuser:mypassword@localhost:27017",
    // "DatabaseName": "novastack_products_dev"
    //
    // Then start the mongo container:  docker-compose up mongo -d
    // No migrations needed — MongoDB is schemaless.
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "product-api-group"
    }
  },
  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "localhost:6379"
  },
  "Observability": {
    "OtlpEndpoint": ""
  }
}
