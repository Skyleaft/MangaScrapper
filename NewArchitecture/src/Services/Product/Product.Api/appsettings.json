{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:5010",
    "Audience": "product-api",
    "RequireHttps": false,
    "CacheMinutes": 60
  },
  //  "Authentication": {
  //   "Issuer": "NovaStack",
  //   "Audience": "product-api",
  //   "RequireHttps": false,
  //   "UseLocalValidation": true,
  //   "Signing": {
  //     "Algorithm": "HS256",
  //     "SymmetricKey": "CHANGE_ME_super_secret_key_at_least_32_chars!"
  //   }
  // },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=postgres;Port=5432;Database=novastack_products;Username=postgres;Password=postgres;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxPoolSize": 100
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest",
      "PrefetchCount": 10
    },
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "GroupId": "product-api-group"
    }
  },
  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "redis:6379",
    "DefaultExpiryMinutes": 15,
    "InstanceName": "products:"
  },
  "Observability": {
    "OtlpEndpoint": ""
  }
}
