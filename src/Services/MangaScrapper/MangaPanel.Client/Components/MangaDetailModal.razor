            <div class="px-4 sm:px-6 py-3 sm:py-4 border-t border-border-main flex items-center justify-end gap-2 sm:gap-3 bg-surface z-10 shadow-[0_-1px_10px_rgba(0,0,0,0.02)] transition-colors duration-300">
                <button @onclick="Close" class="px-4 sm:px-5 py-2 text-slate-500 dark:text-slate-400 font-bold text-xs uppercase tracking-widest hover:bg-bg-app rounded-xl transition-all">
