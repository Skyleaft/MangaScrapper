    private void SyncAnilistResult(MangaSummaryResponse item)
    {
        EditModel.AnilistId = item.AnilistId ?? EditModel.AnilistId;
        EditModel.MalId = item.MalId > 0 ? item.MalId : EditModel.MalId;

        if (item.Rating.HasValue)
            EditModel.Rating = item.Rating;

        if (item.Popularity > 0)
            EditModel.Popularity = item.Popularity;

        if (!string.IsNullOrEmpty(item.Status))
            EditModel.Status = item.Status;

        if (item.ReleaseDate.HasValue)
        {
            EditModel.ReleaseDate = item.ReleaseDate;
        }

        if (item.Genres != null && item.Genres.Any())
        {
            var merged = (EditModel.Genres ?? new List<string>()).Union(item.Genres).ToList();
            EditModel.Genres = merged;
        }

        if (string.IsNullOrEmpty(EditModel.Description) && !string.IsNullOrEmpty(item.Description))
        {
            EditModel.Description = item.Description;
        }

        if (string.IsNullOrEmpty(EditModel.Author) && !string.IsNullOrEmpty(item.Author) && item.Author != "Unknown")
        {
            EditModel.Author = item.Author;
        }

        _isSearchAnilistOpen = false;
        StateHasChanged();
    }

    private void SyncMangaUpdatesResult(MangaSummaryResponse item)
    {
        EditModel.MangaUpdateId = item.MangaUpdateId ?? EditModel.MangaUpdateId;

        if (item.Rating.HasValue)
            EditModel.Rating = item.Rating;

        if (!string.IsNullOrEmpty(item.Status))
            EditModel.Status = item.Status;

        if (item.ReleaseDate.HasValue)
            EditModel.ReleaseDate = item.ReleaseDate;

        if (item.Genres != null && item.Genres.Any())
        {
            var merged = (EditModel.Genres ?? new List<string>()).Union(item.Genres).ToList();
            EditModel.Genres = merged;
        }

        if (item.Categories != null && item.Categories.Any())
        {
            var merged = (EditModel.Categories ?? new List<string>()).Union(item.Categories).ToList();
            EditModel.Categories = merged;
        }

        if (string.IsNullOrEmpty(EditModel.Description) && !string.IsNullOrEmpty(item.Description))
            EditModel.Description = item.Description;

        if (string.IsNullOrEmpty(EditModel.Author) && !string.IsNullOrEmpty(item.Author) && item.Author != "Unknown")
            EditModel.Author = item.Author;

        _isSearchMangaUpdatesOpen = false;
        StateHasChanged();
    }

    private void SyncJikanResult(MangaSummaryResponse item)
    {
        EditModel.MalId = item.MalId > 0 ? item.MalId : EditModel.MalId;
        EditModel.Author = string.IsNullOrEmpty(item.Author) || item.Author == "Unknown" ? EditModel.Author : item.Author;
        EditModel.Rating = item.Rating ?? EditModel.Rating;
        EditModel.ReleaseDate = item.ReleaseDate ?? EditModel.ReleaseDate;
        EditModel.Popularity = item.Popularity > 0 ? item.Popularity : EditModel.Popularity;
        EditModel.Members = item.Members > 0 ? item.Members : EditModel.Members;
        
        if (!string.IsNullOrEmpty(item.Status))
        {
            EditModel.Status = item.Status;
        }

        if (item.Genres != null && item.Genres.Any())
        {
            var merged = (EditModel.Genres ?? new List<string>()).Union(item.Genres).ToList();
            EditModel.Genres = merged;
        }
        
        if (string.IsNullOrEmpty(EditModel.Description) && !string.IsNullOrEmpty(item.Description))
        {
            EditModel.Description = item.Description;
        }

        _isSearchJikanOpen = false;
        StateHasChanged();
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private static string GetStatusClass(string status) => status?.ToLower() switch
    {
        "ongoing" or "publishing" => "bg-emerald-500/10 text-emerald-600",
        "completed" or "finished" => "bg-sky-500/10 text-sky-600",
        "on hiatus" or "hiatus" => "bg-amber-500/10 text-amber-600",
        "discontinued" or "cancelled" => "bg-rose-500/10 text-rose-600",
        "upcoming" => "bg-violet-500/10 text-violet-600",
        _ => "bg-slate-500/10 text-slate-500"
    };

    public class UpdateModel
    {
        public Guid Id { get; set; }
        public int MalId { get; set; }
        public int? AnilistId { get; set; }
        public long? MangaUpdateId { get; set; }
        public string Author { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public List<string>? Genres { get; set; }
        public List<string>? Categories { get; set; }
        public string? Description { get; set; }
        public double? Rating { get; set; }
        public DateTime? ReleaseDate { get; set; }
        public bool? Nsfw { get; set; }
        public string? Status { get; set; }
        public int TotalView { get; set; }
        public int Popularity { get; set; }
        public int Members { get; set; }
    }

    public class ChapterResponse
    {
        public Guid Id { get; set; }
        public double Number { get; set; }
        public string? Title { get; set; }
        public string? Url { get; set; }
        public List<string> Pages { get; set; } = new();
        public string Language { get; set; } = string.Empty;
        public string? ChapterProvider { get; set; }
        public string? ChapterProviderIcon { get; set; }
        public DateTime UploadDate { get; set; }
        public int TotalView { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            try
            {
                if (_currentJoinedMangaId != Guid.Empty)
                {
                    await _hubConnection.SendAsync("LeaveMangaGroup", _currentJoinedMangaId.ToString());
                }
                await _hubConnection.DisposeAsync();
            }
            catch
            {
                // Ignore disposal exceptions
            }
        }
    }
