@implements IAsyncDisposable
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Removed top-level if to allow opening animation to trigger immediately *@

    <div class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 @(_isClosing ? "animate-backdrop-out" : "animate-backdrop-in")">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-5xl max-h-[96vh] sm:max-h-[95vh] overflow-hidden flex flex-col border border-border-main opacity-0
                    @(_isClosing ? "animate-modal-out" : "animate-modal-in")">

            <!-- Modal Header -->
            <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-border-main flex items-center justify-between bg-surface shadow-sm z-10 transition-colors duration-300">
                <div class="flex items-center gap-2 sm:gap-3 overflow-hidden min-w-0">
                    <span class="px-2 py-0.5 sm:py-1 bg-primary/10 text-primary text-[9px] sm:text-[10px] font-bold rounded uppercase flex-shrink-0">Details</span>
                    <h2 class="text-base sm:text-xl font-bold text-text-main truncate">@(Manga?.Title ?? "Loading...")</h2>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
                    <button @onclick="ConfirmDeleteManga" class="p-1.5 sm:p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-lg transition-colors flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3" title="Delete Manga">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        <span class="text-xs font-bold hidden sm:inline">Delete</span>
                    </button>
                    <div class="w-px h-5 sm:h-6 bg-border-main mx-0.5 sm:mx-1"></div>
                    <button @onclick="Close" class="p-1.5 sm:p-2 hover:bg-bg-app rounded-full transition-colors">
                        <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="flex-grow overflow-y-auto bg-bg-app transition-colors duration-300">

                @if (IsLoading)
                {
                    <div class="flex flex-col items-center justify-center py-16 sm:py-24">
                        <div class="animate-spin rounded-full h-10 w-10 sm:h-12 sm:w-12 border-b-2 border-primary mb-4"></div>
                        <p class="text-xs sm:text-sm text-slate-500 font-medium">Loading manga details...</p>
                    </div>
                }
                else
                {
                    <!-- Hero: Cover + Quick Info -->
                    <div class="p-4 sm:p-6 pb-0">
                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-center sm:items-start">
                            <!-- Cover Image -->
                            <div class="flex-shrink-0 w-32 sm:w-36 lg:w-44">
                                <div class="rounded-xl overflow-hidden shadow-lg border border-border-main bg-surface aspect-[3/4] relative group transition-colors duration-300">
                                    @if (!string.IsNullOrEmpty(Manga.LocalImageUrl))
                                    {
                                        <img src="/images/@Manga.LocalImageUrl" alt="@Manga.Title" class="w-full h-full object-cover" />
                                    }
                                    else if (!string.IsNullOrEmpty(Manga.ImageUrl))
                                    {
                                        <img src="@Manga.ImageUrl" alt="@Manga.Title" class="w-full h-full object-cover" />
                                    }
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                                        <span class="text-white text-[10px] font-medium">Cover Image</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Info -->
                            <div class="flex-grow min-w-0 w-full space-y-2.5 sm:space-y-3">
                                <!-- Stats Row -->
                                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                                    @if (!string.IsNullOrEmpty(Manga.Type))
                                    {
                                        <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 bg-primary/10 text-primary text-[9px] sm:text-[10px] font-bold rounded-lg uppercase">@Manga.Type</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Manga.Status))
                                    {
                                        <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 text-[9px] sm:text-[10px] font-bold rounded-lg uppercase @GetStatusClass(Manga.Status)">@Manga.Status</span>
                                    }
                                    @if (Manga.Rating.HasValue)
                                    {
                                        <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 bg-amber-500/10 text-amber-600 text-[9px] sm:text-[10px] font-bold rounded-lg flex items-center gap-1">
                                            <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            @Manga.Rating.Value.ToString("0.0")
                                        </span>
                                    }
                                    @if (Chapters.Count > 0)
                                    {
                                        <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 bg-slate-500/10 text-slate-500 text-[9px] sm:text-[10px] font-bold rounded-lg">@Chapters.Count chapters</span>
                                    }
                                </div>

                                <!-- Metadata Grid -->
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
                                    <div class="bg-surface rounded-xl p-2.5 sm:p-3 border border-border-main">
                                        <label class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Author</label>
                                        <p class="text-xs font-semibold text-text-main truncate">@(string.IsNullOrEmpty(Manga.Author) ? "—" : Manga.Author)</p>
                                    </div>
                                    <div class="bg-surface rounded-xl p-2.5 sm:p-3 border border-border-main">
                                        <label class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Created</label>
                                        <p class="text-xs font-semibold text-text-main">@Manga.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="bg-surface rounded-xl p-2.5 sm:p-3 border border-border-main">
                                        <label class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Updated</label>
                                        <p class="text-xs font-semibold text-text-main">@Manga.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="bg-surface rounded-xl p-2.5 sm:p-3 border border-border-main">
                                        <label class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Views</label>
                                        <p class="text-xs font-semibold text-text-main">@Manga.TotalView.ToString("N0")</p>
                                    </div>
                                </div>

                                <!-- Source & Thumbnail -->
                                <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs">
                                    @if (!string.IsNullOrEmpty(Manga.Url))
                                    {
                                        <a href="@Manga.Url" target="_blank" class="text-primary hover:underline flex items-center gap-1">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                            <span>Source</span>
                                        </a>
                                    }
                                    @if (Manga.ThumbnailSize > 0)
                                    {
                                        <span class="text-slate-400">•</span>
                                        <span class="text-slate-500">Thumbnail: @FormatFileSize(Manga.ThumbnailSize)</span>
                                    }
                                    @if (Manga.MalId > 0)
                                    {
                                        <span class="text-slate-400">•</span>
                                        <span class="text-slate-500">MAL #@Manga.MalId</span>
                                    }
                                </div>

                                <!-- Genres -->
                                @if (Manga.Genres != null && Manga.Genres.Any())
                                {
                                    <div class="flex flex-wrap gap-1 sm:gap-1.5">
                                        @foreach (var genre in Manga.Genres)
                                        {
                                            <span class="px-2 py-0.5 bg-surface border border-border-main text-slate-500 text-[9px] sm:text-[10px] font-bold rounded">@genre</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Tab Navigation -->
                    <div class="px-4 sm:px-6 pt-3 sm:pt-5">
                        <div class="flex gap-1 border-b border-border-main">
                            <button @onclick="() => _activeTab = 0"
                                    class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all relative
                                           @(_activeTab == 0 ? "text-primary" : "text-slate-400 hover:text-slate-600")">
                                <span class="flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    Edit Info
                                </span>
                                @if (_activeTab == 0)
                                {
                                    <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary rounded-full"></span>
                                }
                            </button>
                            <button @onclick="() => _activeTab = 1"
                                    class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all relative
                                           @(_activeTab == 1 ? "text-primary" : "text-slate-400 hover:text-slate-600")">
                                <span class="flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                                    Chapters
                                    <span class="px-1.5 py-0.5 bg-primary/10 text-primary text-[9px] font-bold rounded-full leading-none">@Chapters.Count</span>
                                </span>
                                @if (_activeTab == 1)
                                {
                                    <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary rounded-full"></span>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- Tab Content -->
                    <div class="p-3 sm:p-6">
                        @if (_activeTab == 0)
                        {
                            <!-- Edit Information -->
                            <div class="bg-surface rounded-2xl border border-border-main shadow-sm overflow-hidden transition-colors duration-300">
                                <div class="p-4 sm:p-6 space-y-4 sm:space-y-6">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-5">
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">MAL ID</label>
                                            <div class="flex gap-2">
                                                <input type="number" @bind="EditModel.MalId" class="flex-grow px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="e.g. 123456" />
                                                <button @onclick="OpenJikanSearch" class="p-2 sm:p-2.5 bg-primary/10 text-primary hover:bg-primary/20 rounded-xl transition-all flex-shrink-0" title="Search MyAnimeList">
                                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Anilist ID</label>
                                            <div class="flex gap-2">
                                                <input type="number" @bind="EditModel.AnilistId" class="flex-grow px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="e.g. 98396" />
                                                <button @onclick="OpenAnilistSearch" class="p-2 sm:p-2.5 bg-teal-500/10 text-teal-600 hover:bg-teal-500/20 rounded-xl transition-all flex-shrink-0" title="Search Anilist">
                                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">MangaUpdates ID</label>
                                            <div class="flex gap-2">
                                                <input type="number" @bind="EditModel.MangaUpdateId" class="flex-grow px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="e.g. 1234" />
                                                <button @onclick="OpenMangaUpdatesSearch" class="p-2 sm:p-2.5 bg-purple-500/10 text-purple-600 hover:bg-purple-500/20 rounded-xl transition-all flex-shrink-0" title="Search MangaUpdates">
                                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Author</label>
                                            <input type="text" @bind="EditModel.Author" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="Author name" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Type</label>
                                            <input type="text" @bind="EditModel.Type" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="Manga, Manhwa, etc." />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Status</label>
                                            <input type="text" @bind="EditModel.Status" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="Ongoing, Completed, etc." />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Rating</label>
                                            <input type="number" step="0.1" @bind="EditModel.Rating" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Release Date</label>
                                            <input type="date" @bind="EditModel.ReleaseDate" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-xs sm:text-sm text-text-main" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Total View</label>
                                            <input type="number" @bind="EditModel.TotalView" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Popularity</label>
                                            <input type="number" @bind="EditModel.Popularity" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5">
                                            <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Members</label>
                                            <input type="number" @bind="EditModel.Members" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" />
                                        </div>
                                        <div class="space-y-1 sm:space-y-1.5 flex items-center pt-2 sm:mt-6">
                                            <label class="flex items-center gap-2 cursor-pointer">
                                                <input type="checkbox" @bind="EditModel.Nsfw" class="w-4 h-4 text-primary bg-bg-app border-border-main rounded focus:ring-primary/20" />
                                                <span class="text-xs font-bold text-slate-600 dark:text-slate-400">NSFW (18+)</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="space-y-1 sm:space-y-1.5">
                                        <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Genres</label>
                                        <div class="relative">
                                            <input type="text" value="@GenresString" @onchange="OnGenresChanged" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="Action, Adventure, etc." />
                                            <div class="mt-2 flex flex-wrap gap-1 sm:gap-1.5">
                                                @if (EditModel.Genres != null)
                                                {
                                                    @foreach (var genre in EditModel.Genres)
                                                    {
                                                        <span class="px-2 py-0.5 bg-bg-app border border-border-main text-slate-600 dark:text-slate-400 text-[9px] sm:text-[10px] font-bold rounded">@genre</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="space-y-1 sm:space-y-1.5">
                                        <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Categories</label>
                                        <div class="relative">
                                            <input type="text" value="@CategoriesString" @onchange="OnCategoriesChanged" class="w-full px-3.5 sm:px-4 py-2 sm:py-2.5 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main" placeholder="Category 1, Category 2, etc." />
                                            <div class="mt-2 flex flex-wrap gap-1 sm:gap-1.5">
                                                @if (EditModel.Categories != null)
                                                {
                                                    @foreach (var category in EditModel.Categories)
                                                    {
                                                        <span class="px-2 py-0.5 bg-bg-app border border-border-main text-slate-600 dark:text-slate-400 text-[9px] sm:text-[10px] font-bold rounded">@category</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="space-y-1 sm:space-y-1.5">
                                        <label class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">Description</label>
                                        <textarea @bind="EditModel.Description" rows="4" class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 bg-bg-app border border-border-main rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder-slate-400 text-xs sm:text-sm text-text-main resize-none" placeholder="Enter manga description..."></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Chapters List -->
                            <div class="bg-surface rounded-2xl border border-border-main shadow-sm overflow-hidden transition-colors duration-300">
                                <!-- Chapters Header -->
                                <div class="px-4 sm:px-6 py-3 border-b border-border-main/50 flex items-center justify-between bg-bg-app transition-colors duration-300">
                                    <div class="flex items-center gap-2 sm:gap-3">
                                        <span class="text-[11px] sm:text-xs text-slate-400">
                                            @{ var availableCount = Chapters.Count(c => c.Pages.Count>0); }
                                            <span class="font-bold text-emerald-500">@availableCount</span> available
                                            <span class="mx-1">·</span>
                                            <span class="font-bold text-rose-400">@(Chapters.Count - availableCount)</span> missing
                                        </span>
                                    </div>
                                    <button @onclick="ScrapMissingChapters" disabled="@_isScrapingActive" class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 bg-secondary/10 text-secondary hover:bg-secondary/20 rounded-lg transition-all text-[9px] sm:text-[10px] font-bold uppercase tracking-wider disabled:opacity-50">
                                        @if (_isScrapingActive)
                                        {
                                            <div class="w-3.5 h-3.5 border-2 border-secondary/30 border-t-secondary rounded-full animate-spin"></div>
                                            <span>Scraping...</span>
                                        }
                                        else
                                        {
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                            <span>Scrap Missing</span>
                                        }
                                    </button>
                                </div>

                                @if (_isScrapingActive)
                                {
                                    <!-- Live Scraping Progress Bar Widget -->
                                    <div class="p-3 sm:p-4 bg-surface border-b border-border-main transition-all">
                                        <div class="p-3.5 sm:p-4 bg-bg-app rounded-xl border border-secondary/30 shadow-sm relative overflow-hidden">
                                            <!-- Top Line Gradient Fill -->
                                            <div class="absolute inset-x-0 top-0 h-1 bg-slate-200 dark:bg-slate-800">
                                                <div class="h-full bg-gradient-to-r from-secondary to-primary transition-all duration-300" style="width: @(_scrapingPercent)%"></div>
                                            </div>

                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center flex-shrink-0">
                                                        @if (_scrapingStatus == "Completed")
                                                        {
                                                            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                                        }
                                                        else if (_scrapingStatus == "Failed")
                                                        {
                                                            <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                        }
                                                        else
                                                        {
                                                            <div class="w-4 h-4 border-2 border-secondary/30 border-t-secondary rounded-full animate-spin"></div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <div class="flex items-center gap-2">
                                                            <span class="text-xs font-bold text-text-main">
                                                                @if (_scrapingStatus == "Completed")
                                                                {
                                                                    <span class="text-emerald-500">Chapter @_scrapingChapterNumber completed!</span>
                                                                }
                                                                else if (_scrapingStatus == "Failed")
                                                                {
                                                                    <span class="text-rose-500">Failed scraping Chapter @_scrapingChapterNumber</span>
                                                                }
                                                                else if (_scrapingStatus == "Queued")
                                                                {
                                                                    <span>Queued for scraping...</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>Scraping Chapter @_scrapingChapterNumber</span>
                                                                }
                                                            </span>
                                                            <span class="px-2 py-0.5 bg-secondary/10 text-secondary text-[9px] font-bold rounded-full uppercase">
                                                                @_scrapingStatus
                                                            </span>
                                                        </div>
                                                        <p class="text-[11px] text-slate-400 mt-0.5">
                                                            @if (_scrapingTotalPages > 0)
                                                            {
                                                                <span>Downloading page @_scrapingDownloadedPages of @_scrapingTotalPages (@_scrapingPercent%)</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Worker processing chapter download...</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2.5 w-full sm:w-48 flex-shrink-0">
                                                    <div class="flex-grow bg-slate-200 dark:bg-slate-700/60 rounded-full h-2 overflow-hidden">
                                                        <div class="h-full bg-gradient-to-r from-secondary to-primary transition-all duration-300 rounded-full" style="width: @(_scrapingPercent)%"></div>
                                                    </div>
                                                    <span class="text-xs font-bold text-text-main w-8 text-right">@_scrapingPercent%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Chapters Table -->
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-xs sm:text-sm">
                                        <thead class="bg-bg-app/50 border-b border-border-main">
                                            <tr>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider w-20 sm:w-24">Ch.</th>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider w-16 sm:w-20">Lang</th>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider">Status</th>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider hidden sm:table-cell">Provider</th>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider hidden md:table-cell">Date</th>
                                                <th class="px-4 sm:px-5 py-2.5 font-bold text-slate-400 text-[9px] sm:text-[10px] uppercase tracking-wider text-right w-16 sm:w-20">Views</th>
                                                <th class="px-3 sm:px-5 py-2.5 w-10 sm:w-12"></th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-border-main/50">
                                            @if (!Chapters.Any())
                                            {
                                                <tr>
                                                    <td colspan="7" class="px-5 py-12 text-center">
                                                        <div class="flex flex-col items-center gap-2">
                                                            <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                                            <p class="text-slate-400 text-xs">No chapters found</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var chapter in Chapters)
                                                {
                                                    <tr class="hover:bg-bg-app/50 transition-colors group">
                                                        <td class="px-4 sm:px-5 py-2.5">
                                                            <span class="font-bold text-text-main text-xs sm:text-sm">@chapter.Number</span>
                                                        </td>
                                                        <td class="px-4 sm:px-5 py-2.5">
                                                            <span class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-500 text-[9px] sm:text-[10px] font-bold rounded uppercase">@(string.IsNullOrEmpty(chapter.Language) ? "—" : chapter.Language)</span>
                                                        </td>
                                                        <td class="px-4 sm:px-5 py-2.5">
                                                            @if (_isScrapingActive && (_scrapingChapterId == chapter.Id || _scrapingChapterNumber == chapter.Number) && _scrapingStatus != "Completed")
                                                            {
                                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-secondary/10 text-secondary rounded-full text-[9px] sm:text-[10px] font-bold animate-pulse">
                                                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                                                    @(_scrapingPercent > 0 ? $"{_scrapingPercent}%" : "Scraping")
                                                                </span>
                                                            }
                                                            else if (chapter.Pages.Count>0)
                                                            {
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 rounded-full text-[9px] sm:text-[10px] font-bold">
                                                                    <span class="w-1 h-1 rounded-full bg-emerald-500"></span>
                                                                    @chapter.Pages.Count pg
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-rose-50 dark:bg-rose-900/20 text-rose-500 rounded-full text-[9px] sm:text-[10px] font-bold">
                                                                    <span class="w-1 h-1 rounded-full bg-rose-400 animate-pulse"></span>
                                                                    Missing
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="px-4 sm:px-5 py-2.5 hidden sm:table-cell">
                                                            @if (!string.IsNullOrEmpty(chapter.ChapterProvider))
                                                            {
                                                                <span class="flex items-center gap-1.5 text-xs text-slate-500">
                                                                    @if (!string.IsNullOrEmpty(chapter.ChapterProviderIcon))
                                                                    {
                                                                        <img src="@chapter.ChapterProviderIcon" class="w-3.5 h-3.5 rounded" alt="" />
                                                                    }
                                                                    @chapter.ChapterProvider
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-300 text-xs">—</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 sm:px-5 py-2.5 text-slate-500 text-xs whitespace-nowrap hidden md:table-cell">@chapter.UploadDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                                        <td class="px-4 sm:px-5 py-2.5 text-slate-500 text-xs text-right font-medium">@chapter.TotalView.ToString("N0")</td>
                                                        <td class="px-3 sm:px-5 py-2.5 text-right">
                                                            <button @onclick="() => ConfirmDeleteChapter(chapter)" class="p-1 text-slate-300 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-lg transition-all" title="Delete Chapter">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

