    private string GenresString => EditModel.Genres != null ? string.Join(", ", EditModel.Genres) : "";
    private string CategoriesString => EditModel.Categories != null ? string.Join(", ", EditModel.Categories) : "";

    protected override async Task OnParametersSetAsync()
    {
        if (MangaId != Guid.Empty)
        {
            await LoadManga();
            await SetupSignalR();
        }
    }

    private async Task SetupSignalR()
    {
        try
        {
            if (_hubConnection == null)
            {
                _hubConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/hubs/manga"))
                    .WithAutomaticReconnect()
                    .Build();

                _hubConnection.On<System.Text.Json.JsonElement>("ChaptersUpdated", async (payload) =>
                {
                    if (MangaId != Guid.Empty)
                    {
                        var match = false;
                        if (payload.TryGetProperty("mangaId", out var mangaIdProp))
                        {
                            if (mangaIdProp.ValueKind == System.Text.Json.JsonValueKind.String &&
                                Guid.TryParse(mangaIdProp.GetString(), out var eventMangaId) &&
                                eventMangaId == MangaId)
                            {
                                match = true;
                            }
                        }

                        if (match)
                        {
                            await RefreshChapters();
                        }
                    }
                });

                _hubConnection.On<System.Text.Json.JsonElement>("ChapterScrapingProgress", async (payload) =>
                {
                    if (MangaId != Guid.Empty)
                    {
                        var match = false;
                        if (payload.TryGetProperty("mangaId", out var mangaIdProp))
                        {
                            if (mangaIdProp.ValueKind == System.Text.Json.JsonValueKind.String &&
                                Guid.TryParse(mangaIdProp.GetString(), out var eventMangaId) &&
                                eventMangaId == MangaId)
                            {
                                match = true;
                            }
                        }

                        if (match)
                        {
                            _isScrapingActive = true;
                            if (payload.TryGetProperty("chapterNumber", out var chProp)) _scrapingChapterNumber = chProp.GetDouble();
                            if (payload.TryGetProperty("chapterId", out var chIdProp) && Guid.TryParse(chIdProp.GetString(), out var chId)) _scrapingChapterId = chId;
                            if (payload.TryGetProperty("downloadedPages", out var dlProp)) _scrapingDownloadedPages = dlProp.GetInt32();
                            if (payload.TryGetProperty("totalPages", out var totalProp)) _scrapingTotalPages = totalProp.GetInt32();
                            if (payload.TryGetProperty("percent", out var pctProp)) _scrapingPercent = pctProp.GetInt32();
                            if (payload.TryGetProperty("status", out var statusProp)) _scrapingStatus = statusProp.GetString() ?? "InProgress";

                            if (_scrapingStatus == "Completed")
                            {
                                await RefreshChapters();
                                _ = Task.Run(async () =>
                                {
                                    await Task.Delay(4000);
                                    if (_scrapingStatus == "Completed" && _scrapingPercent >= 100)
                                    {
                                        _isScrapingActive = false;
                                        await InvokeAsync(StateHasChanged);
                                    }
                                });
                            }
                            else if (_scrapingStatus == "Failed")
                            {
                                _ = Task.Run(async () =>
                                {
                                    await Task.Delay(5000);
                                    _isScrapingActive = false;
                                    await InvokeAsync(StateHasChanged);
                                });
                            }

                            await InvokeAsync(StateHasChanged);
                        }
                    }
                });

                await _hubConnection.StartAsync();
            }

            if (_hubConnection.State == HubConnectionState.Connected)
            {
                if (_currentJoinedMangaId != Guid.Empty && _currentJoinedMangaId != MangaId)
                {
                    await _hubConnection.SendAsync("LeaveMangaGroup", _currentJoinedMangaId.ToString());
                }
                await _hubConnection.SendAsync("JoinMangaGroup", MangaId.ToString());
                _currentJoinedMangaId = MangaId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MangaDetailModal] SignalR error: {ex.Message}");
        }
    }

    private async Task RefreshChapters()
    {
        try
        {
            var chapters = await Http.GetApiDataAsync<List<ChapterResponse>>($"/api/v1/manga/{MangaId}/chapters");
            if (chapters != null)
            {
                Chapters = chapters;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MangaDetailModal] Error refreshing chapters via SignalR: {ex.Message}");
        }
    }

    private async Task LoadManga()
    {
        IsLoading = true;
        try
        {
            var mangaTask = Http.GetApiDataAsync<MangaSummary>($"/api/v1/manga/{MangaId}");
            var chaptersTask = Http.GetApiDataAsync<List<ChapterResponse>>($"/api/v1/manga/{MangaId}/chapters");
            
            await Task.WhenAll(mangaTask, chaptersTask);

            Manga = await mangaTask;
            Chapters = await chaptersTask ?? new();

            if (Manga != null)
            {
                EditModel = new UpdateModel
                {
                    Id = Manga.Id,
                    MalId = Manga.MalId,
                    AnilistId = Manga.AnilistId ?? 0,
                    MangaUpdateId = Manga.MangaUpdateId,
                    Author = Manga.Author,
                    Type = Manga.Type,
                    Genres = Manga.Genres ?? new List<string>(),
                    Categories = Manga.Categories ?? new List<string>(),
                    Description = Manga.Description,
                    Rating = Manga.Rating,
                    ReleaseDate = Manga.ReleaseDate,
                    Nsfw = Manga.Nsfw,
                    Status = Manga.Status,
                    TotalView = Manga.TotalView,
                    Popularity = Manga.Popularity,
                    Members = Manga.Members
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading manga: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnGenresChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val))
        {
            EditModel.Genres = val.Split(',').Select(x => x.Trim()).ToList();
        }
        else
        {
            EditModel.Genres = new List<string>();
        }
    }

    private void OnCategoriesChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val))
        {
            EditModel.Categories = val.Split(',').Select(x => x.Trim()).ToList();
        }
        else
        {
            EditModel.Categories = new List<string>();
        }
    }

    private async Task Save()
    {
        IsSaving = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"/api/v1/manga/{MangaId}", EditModel);
            if (response.IsSuccessStatusCode)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error saving: {content}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ConfirmDeleteManga()
    {
        if (Manga == null) return;
        
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the entire manga '{Manga.Title}'?\n\nThis will also delete ALL downloaded chapters and images. This action cannot be undone.");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/v1/manga/{MangaId}");
                if (response.IsSuccessStatusCode)
                {
                    await OnSaved.InvokeAsync();
                    await Close();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting manga: {ex.Message}");
            }
        }
    }

    private async Task ConfirmDeleteChapter(ChapterResponse chapter)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete Chapter {chapter.Number} from storage and database?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/v1/manga/{MangaId}/chapter/{chapter.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Chapters.Remove(chapter);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting chapter: {ex.Message}");
            }
        }
    }

    private async Task ScrapMissingChapters()
    {
        try 
        {
            _isScrapingActive = true;
            _scrapingStatus = "Queued";
            _scrapingPercent = 0;
            _scrapingDownloadedPages = 0;
            _scrapingTotalPages = 0;
            StateHasChanged();

            var response = await Http.GetAsync($"/api/v1/scrapper/manga/{MangaId}/chapter-pages");
            if (!response.IsSuccessStatusCode)
            {
                _scrapingStatus = "Failed";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error triggering scrap: {ex.Message}");
            _scrapingStatus = "Failed";
            StateHasChanged();
        }
    }

    private async Task Close()
    {
        _isClosing = true;
        StateHasChanged();
        await Task.Delay(300); // Wait for animation
        await OnClosed.InvokeAsync();
    }

